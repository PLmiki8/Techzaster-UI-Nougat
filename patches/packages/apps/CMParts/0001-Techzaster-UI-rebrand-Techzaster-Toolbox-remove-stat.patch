diff --git a/src/org/cyanogenmod/cmparts/statusbar/QsGridSettings.java b/src/org/cyanogenmod/cmparts/statusbar/QsGridSettings.java
new file mode 100644
index 0000000..fe0264b
--- /dev/null
+++ b/src/org/cyanogenmod/cmparts/statusbar/QsGridSettings.java
@@ -0,0 +1,49 @@
+package org.cyanogenmod.cmparts.statusbar;
+
+import android.os.Bundle;
+import android.provider.Settings;
+import android.support.v7.preference.ListPreference;
+import android.support.v7.preference.Preference;
+import android.widget.Toast;
+
+import org.cyanogenmod.cmparts.R;
+import org.cyanogenmod.cmparts.SettingsPreferenceFragment;
+
+public class QsGridSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String KEY_COLUMNS = "qs_grid_columns";
+    private static final String SETTING_COLUMNS = "techzaster_qs_columns";
+
+    private ListPreference mColumns;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.qs_grid_settings);
+
+        mColumns = (ListPreference) findPreference(KEY_COLUMNS);
+        if (mColumns != null) {
+            int current = Settings.Secure.getInt(
+                    getActivity().getContentResolver(), SETTING_COLUMNS, 3);
+            mColumns.setValue(String.valueOf(current));
+            mColumns.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (preference == mColumns) {
+            try {
+                Settings.Secure.putInt(getActivity().getContentResolver(),
+                        SETTING_COLUMNS, Integer.parseInt((String) newValue));
+                return true;
+            } catch (Exception e) {
+                Toast.makeText(getActivity(), "Could not save the setting",
+                        Toast.LENGTH_SHORT).show();
+                return false;
+            }
+        }
+        return false;
+    }
+}
