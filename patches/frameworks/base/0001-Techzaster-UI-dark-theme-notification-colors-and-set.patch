diff --git a/packages/SystemUI/src/com/android/systemui/qs/TileLayout.java b/packages/SystemUI/src/com/android/systemui/qs/TileLayout.java
index a5a1eaaf666..2d66b3bc729 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/TileLayout.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/TileLayout.java
@@ -1,7 +1,10 @@
 package com.android.systemui.qs;
 
+import com.android.systemui.tuner.TunerService;
+import com.android.systemui.tuner.TunerService.Tunable;
 import android.content.Context;
 import android.content.res.Resources;
+import android.provider.Settings;
 import android.util.AttributeSet;
 import android.view.View;
 import android.view.ViewGroup;
@@ -12,7 +15,7 @@ import com.android.systemui.qs.QSPanel.TileRecord;
 
 import java.util.ArrayList;
 
-public class TileLayout extends ViewGroup implements QSTileLayout {
+public class TileLayout extends ViewGroup implements QSTileLayout, Tunable {
 
     private static final float TILE_ASPECT = 1.2f;
 
@@ -35,6 +38,7 @@ public class TileLayout extends ViewGroup implements QSTileLayout {
         super(context, attrs);
         setFocusableInTouchMode(true);
         updateResources();
+        TunerService.get(context).addTunable(this, TECHZASTER_QS_COLUMNS);
     }
 
     @Override
@@ -72,9 +76,13 @@ public class TileLayout extends ViewGroup implements QSTileLayout {
         super.removeAllViews();
     }
 
+        private static final String TECHZASTER_QS_COLUMNS = "techzaster_qs_columns";
+
     public boolean updateResources() {
         final Resources res = mContext.getResources();
-        final int columns = Math.max(1, res.getInteger(R.integer.quick_settings_num_columns));
+        final int defaultColumns = Math.max(1, res.getInteger(R.integer.quick_settings_num_columns));
+        final int columns = Settings.Secure.getInt(mContext.getContentResolver(),
+                TECHZASTER_QS_COLUMNS, defaultColumns);
         mCellHeight = mContext.getResources().getDimensionPixelSize(R.dimen.qs_tile_height);
         mCellMargin = res.getDimensionPixelSize(R.dimen.qs_tile_margin);
         mCellMarginTop = res.getDimensionPixelSize(R.dimen.qs_tile_margin_top);
@@ -132,6 +140,13 @@ public class TileLayout extends ViewGroup implements QSTileLayout {
         }
     }
 
+    @Override
+    public void onTuningChanged(String key, String newValue) {
+        if (TECHZASTER_QS_COLUMNS.equals(key)) {
+            updateResources();
+        }
+    }
+
     private int getRowTop(int row) {
         return row * (mCellHeight + mCellMargin) + mCellMarginTop;
     }
