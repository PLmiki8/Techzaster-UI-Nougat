From 6605c4740fc8537a6c455b557b4e1c8c0ea51e71 Mon Sep 17 00:00:00 2001
From: plmiki8 <350455311+PLmiki8@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:37:19 +0100
Subject: [PATCH] Techzaster UI: version name, default wallpaper, ringtone

Change-Id: I322a4c0d3dbed2784ffd47d37fab862de483ef45
---
 config/common.mk                              |   7 ++++---
 config/telephony.mk                           |   2 +-
 .../res/drawable-hdpi/default_wallpaper.png   | Bin 270522 -> 4975 bytes
 .../res/drawable-nodpi/default_wallpaper.png  | Bin 194692 -> 4975 bytes
 .../default_wallpaper.png                     | Bin 738274 -> 4975 bytes
 .../default_wallpaper.png                     | Bin 738274 -> 4975 bytes
 .../res/drawable-xhdpi/default_wallpaper.png  | Bin 501080 -> 4975 bytes
 .../res/drawable-xxhdpi/default_wallpaper.png | Bin 1208350 -> 4975 bytes
 .../drawable-xxxhdpi/default_wallpaper.png    | Bin 2607862 -> 4975 bytes
 9 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 55d1dac8..78df5fd6 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -92,7 +92,6 @@ endif
 
 # Bootanimation
 PRODUCT_PACKAGES += \
-    bootanimation.zip
 
 # Required CM packages
 PRODUCT_PACKAGES += \
@@ -124,8 +123,6 @@ PRODUCT_PACKAGES += \
     ExactCalculator \
     Jelly \
     LockClock \
-    Trebuchet \
-    Updater \
     WallpaperPicker \
     WeatherProvider
 
@@ -330,6 +327,7 @@ PRODUCT_EXTRA_RECOVERY_KEYS += \
 -include vendor/cm-priv/keys/keys.mk
 
 CM_DISPLAY_VERSION := $(LINEAGE_VERSION)
+TECHZASTER_BUILD_NAME := TechzasterUI-Nougat-$(shell date -u +%Y%m%d)-UNOFFICIAL-$(CM_BUILD)
 
 ifneq ($(PRODUCT_DEFAULT_DEV_CERTIFICATE),)
 ifneq ($(PRODUCT_DEFAULT_DEV_CERTIFICATE),build/target/product/security/testkey)
@@ -362,3 +360,6 @@ PRODUCT_PROPERTY_OVERRIDES += \
 -include vendor/cyngn/product.mk
 
 $(call prepend-product-if-exists, vendor/extra/product.mk)
+
+# Techzaster UI: boot animation, ringtone, preinstalled apps and defaults
+$(call inherit-product-if-exists, vendor/techzaster/techzaster.mk)
diff --git a/config/telephony.mk b/config/telephony.mk
index d6a5b01d..c87d6986 100644
--- a/config/telephony.mk
+++ b/config/telephony.mk
@@ -14,4 +14,4 @@ PRODUCT_PACKAGES += \
 
 # Default ringtone
 PRODUCT_PROPERTY_OVERRIDES += \
-    ro.config.ringtone=Orion.ogg
+    ro.config.ringtone=Blooming_Flower.wav
diff --git a/overlay/common/frameworks/base/core/res/res/drawable-hdpi/default_wallpaper.png b/overlay/common/frameworks/base/core/res/res/drawable-hdpi/default_wallpaper.png
index 0b52678a7e886455c92bddcd16c79b7f3f099faa..31c0f636f5d284bb6aacb1a0d9fab5005284101e 100644
